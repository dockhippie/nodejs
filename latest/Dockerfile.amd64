FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:8162fc609de64c04bd21b7a2e384f6246865938c53d5709e74c5d8a201ff7a98

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
