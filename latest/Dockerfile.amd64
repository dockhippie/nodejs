FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:a5b5b5738198c9959ee9b97b58fa50c8bfd4b22ac562797c270a55aca384d0eb

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
