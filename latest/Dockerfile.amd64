FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:3eaa11d5705266fbd17fb0b23630c5bec26520f9ef3c56385d07ef6a5cf6adb8

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
