FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:9587316c5950be778fea2c52812e1f680a89a2723fe6e6bf244ab752b61d5821

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
