FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:b7a5a19d14a251a40a27d679e07a3661493b5e154830caf8fb51b9812aea0bc2

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
