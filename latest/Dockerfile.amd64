FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:b8c8a2164aa640092a989d87ae81f820d69de2f9d24134ca2f4223877487ccd5

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
