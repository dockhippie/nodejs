FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:3bc741aa7a7d205d2072f9a9e27fc5013dfe4638aca7fbebd562eaad2474847f

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
