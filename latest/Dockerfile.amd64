FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:d5685e65dc2115f14378965ccd7c870abfede1dc4d1351cbb9a566c91fe3bc3e

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
