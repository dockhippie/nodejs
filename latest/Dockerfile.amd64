FROM ghcr.io/dockhippie/alpine:latest-amd64@sha256:ea1feeff5badc52f4336db1dececa292f2d87e9f30d7457899ed33bb6bd3eab6

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
