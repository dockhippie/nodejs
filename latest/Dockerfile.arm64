FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:42e9d6026db421728148551f4a047445739893f51ca8b854d9caa66e54f99f7e

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
