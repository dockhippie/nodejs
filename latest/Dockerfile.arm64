FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:fd6b64c28999f89881292745d098065d8114d2b1a05f1176d2ab60c87a96b78e

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
