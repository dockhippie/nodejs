FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:54779ecd1011d1b6b3fd41754155d1de042d378f9fc53bc4ed276ae22f7ed572

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
