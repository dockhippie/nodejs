FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:1492f5aaf2d87eddcaea16b7be2517d625863ab75320c765172d693f2305cb95

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
