FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:d8ff6b55d1d4ffe07bf9730caf91a6b2ae33bfcdc2fff3c6c0ba5418d7faf481

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
