FROM ghcr.io/dockhippie/alpine:latest-arm64@sha256:3da335cc3688949b68abb3b4c50e9dd737b92e8811291ced7966423cde426276

WORKDIR /srv/app

COPY ./overlay /

RUN apk update && \
  apk upgrade && \
  apk add build-base git nodejs-dev nodejs npm yarn file autoconf automake && \
  yarn global add gulp grunt-cli bower && \
  rm -rf /var/cache/apk/*
